generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScanResult {
  id          String   @id @default(cuid())
  type        String   // malware, phishing, ids, url
  target      String   // file hash, URL, IP, email content
  threatLevel String   // critical, high, medium, low, safe
  score       Int      // 0-100 threat score
  details     String   // JSON string with full analysis
  rawResponse String?  // AI raw response
  createdAt   DateTime @default(now())
}

model ThreatAlert {
  id          String   @id @default(cuid())
  type        String   // intrusion, malware, phishing, suspicious, info
  severity    String   // critical, high, medium, low, info
  source      String   // source IP, domain, etc.
  description String   // alert description
  details     String?  // JSON string with additional data
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SystemMetric {
  id        String   @id @default(cuid())
  metricType String  // threats_blocked, scans_performed, active_monitors, etc.
  value     Int
  timestamp DateTime @default(now())
}
